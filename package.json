{
  "name": "numa",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "tsx apps/api/src/server.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:backup": "tsx scripts/backup.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,html}\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.{ts,mjs}\" *.json",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html}\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.{ts,mjs}\" *.json *.ts",
    "testnet:setup": "tsx scripts/testnet-setup.ts",
    "testnet:smoke": "tsx scripts/testnet-smoke.ts",
    "testnet:worker-smoke": "tsx scripts/testnet-worker-smoke.ts",
    "ai:smoke": "tsx scripts/model-smoke.ts",
    "db:verify-backup": "tsx scripts/check-backup.ts",
    "testnet:secure-executor": "tsx scripts/secure-executor.ts",
    "testnet:product-smoke": "tsx scripts/live-product-smoke.ts",
    "testnet:savings-smoke": "tsx scripts/savings-smoke.ts",
    "db:reconcile": "tsx scripts/reconcile.ts",
    "judge": "tsx scripts/judge.ts",
    "intents:smoke": "tsx scripts/intents-smoke.ts",
    "doctor": "tsx scripts/doctor.ts",
    "verify": "tsx scripts/verify.ts",
    "review:smoke": "tsx scripts/review-smoke.ts",
    "test:contract": "tsx scripts/contract-test.ts"
  },
  "dependencies": {
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@hot-labs/near-connect": "0.12.0",
    "@near-js/accounts": "^2.5.1",
    "@near-js/crypto": "^2.5.1",
    "@near-js/providers": "^2.5.1",
    "@near-js/signers": "^2.5.1",
    "@near-js/transactions": "^2.5.1",
    "@noble/curves": "^2.0.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "lucide-react": "^0.548.0",
    "luxon": "^3.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "dotenv": "^17.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
